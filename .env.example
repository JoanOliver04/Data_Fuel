# ─── Backend / Database ───────────────────────────────────
# Async drivers only. SQLite for local dev/CI (default); PostgreSQL for prod.
DATABASE_URL=sqlite+aiosqlite:///./datafuel.db
# PostgreSQL example (Railway/Render/Fly hand out postgres:// — auto-upgraded):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/datafuel
# Connection-pool tuning (PostgreSQL only; ignored for SQLite):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_SLOW_QUERY_MS=500

# ─── Logging ──────────────────────────────────────────────
# DEBUG (verbose) | INFO | WARNING | ERROR | CRITICAL.
# DEBUG=true overrides this and forces DEBUG.
LOG_LEVEL=INFO

# ─── MITECO API (no key required) ─────────────────────────
# Base URL — append /EstacionesTerrestres/, /FiltroProvincia/{id}, etc.
MITECO_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes

# ─── Cost per km (default: 0.13 €/km) ────────────────────
DEFAULT_KM_COST=0.13

# ─── Distance calculation ────────────────────────────────
# Routing provider selected per DISTANCE_MODE:
#   EUCLIDEAN | HAVERSINE → straight-line (no key, offline)
#   DRIVING | DRIVING_ORS → OpenRouteService road distance (needs ORS_API_KEY)
#   DRIVING_TOMTOM        → TomTom traffic-aware ETA (needs TOMTOM_API_KEY)
# DRIVING is the legacy alias of DRIVING_ORS; a missing key degrades to haversine.
DISTANCE_MODE=EUCLIDEAN
# Required when DISTANCE_MODE=DRIVING/DRIVING_ORS. Get a free key at openrouteservice.org.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_REQUEST_TIMEOUT=10.0
ORS_MATRIX_CHUNK_SIZE=50

# ─── TomTom Routing (Matrix Routing v2, traffic-aware) ────
# Second driving-distance provider. Client layer only for now; provider
# selection is wired in a later phase. Get a free key at developer.tomtom.com
# (free tier ~2500 req/day, 5 req/s — verify current limits).
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_REQUEST_TIMEOUT=20.0

# ─── ML automated retraining ──────────────────────────────
# Weekly retraining of the Random Forest recommendation model. Disabled by
# default (the fit is CPU/memory heavy). When enabled, the scheduler runs the
# pipeline on RETRAIN_CRON (UTC): export → train → evaluate vs active → activate.
# Requires SCHEDULER_ENABLED=true OR sets up its own scheduler when standalone.
RETRAIN_ENABLED=false
# 5-field cron in UTC. Default: every Sunday at 03:00.
RETRAIN_CRON=0 3 * * 0
# Wall-clock ceiling for one scheduled run (seconds); the job aborts past this.
RETRAIN_TIMEOUT_SECONDS=3600
# Acceptance gate. A candidate is rejected unless it stays within tolerance of
# the active model. Optional absolute guards (leave empty to disable):
RETRAIN_MAX_MAE=
RETRAIN_MIN_R2=
# Relative guards vs the active model (defaults shown):
RETRAIN_MAX_MAE_REGRESSION_PCT=0.10
RETRAIN_MAX_R2_ABSOLUTE_DROP=0.05

# ─── Rate limiting ────────────────────────────────────────
GEOCODING_RATE_LIMIT=10/minute
PREDICTIONS_RATE_LIMIT=30/minute
AI_RATE_LIMIT=20/minute
# Explainable-AI endpoints (/api/v1/xai/*). The explain call runs SHAP (~100 ms
# CPU), so it is throttled a touch tighter than plain predictions.
XAI_RATE_LIMIT=20/minute
# Master switch for the SHAP local-explanation path (startup warm-up + per-request
# SHAP). Default true → full XAI (localhost / academic showcase). Set false in
# memory-constrained deployments (Render Free 512 MB): explain-recommendation
# degrades to deterministic reasoning, the costly numba/llvmlite warm-up is skipped.
# The real RAM saving also requires NOT installing the `xai` extra in that image.
XAI_ENABLED=true

# ─── Conversational AI (LLM) ──────────────────────────────
# The LLM only writes prose (explanations/summaries). Prices, predictions and
# verdicts always come from the ML/business layer — never the model. With the
# default provider (fallback) the app makes ZERO network calls and returns
# deterministic explanations, so it works fully without any key.
AI_ENABLED=true
# Provider: fallback | openrouter | groq | ollama | openai. OpenRouter is the
# recommended production provider. (DATAFUEL_LLM_PROVIDER is an accepted alias.)
DATAFUEL_LLM_PROVIDER=openrouter
# OpenRouter (default prod). Get a key at openrouter.ai. Model defaults to DeepSeek Chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Groq (OpenAI-compatible). Used when DATAFUEL_LLM_PROVIDER=groq.
GROQ_API_KEY=
# Generic overrides (optional). LLM_API_KEY is the fallback key for any provider;
# LLM_BASE_URL / LLM_MODEL override the provider preset (e.g. a local Ollama URL).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Resilience + cost guards.
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_INPUT_CHARS=2000
AI_CACHE_TTL_SECONDS=900

# ─── Intelligent alerts ───────────────────────────────────
# Background alert engine: the scheduler evaluates enabled alerts on an interval
# and delivers deduplicated, spam-free notifications. Fully isolated from core
# endpoints; failures degrade gracefully. Requires SCHEDULER access (the job is
# registered automatically when ALERTS_ENABLED=true).
ALERTS_ENABLED=true
ALERTS_EVAL_INTERVAL_SECONDS=900
# Max alerts evaluated per tick (loop back-pressure).
ALERTS_EVAL_BATCH_SIZE=200
# Anti-spam: default cooldown between re-triggers + dedup window for identical state.
ALERTS_DEFAULT_COOLDOWN_MINUTES=360
ALERTS_DEDUP_WINDOW_MINUTES=1440
ALERTS_MAX_PER_USER=50
ALERTS_RATE_LIMIT=30/minute
# Optional: rephrase the deterministic alert message via the LLM (off by default;
# never adds figures — see docs/alerts.md).
ALERTS_LLM_EXPLANATIONS=false

# ─── CORS (comma-separated list of allowed origins) ───────
# Vite dev → :5173, Vite preview → :4173.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Frontend ─────────────────────────────────────────────
# Leave empty in local dev/preview so the frontend uses relative `/api/*`
# paths and Vite's proxy forwards to the backend (no CORS in browser).
# In production, set the absolute backend URL (e.g. https://api.datafuel.app).
VITE_API_BASE_URL=
# Map basemap tiles. When set, the app uses TomTom raster tiles (fast CDN,
# richer detail) instead of the OSM public server, which is disallowed for
# production traffic. This key reaches the browser, so use a SEPARATE TomTom
# key restricted to the Maps Tile API + your domain — NOT the backend
# TOMTOM_API_KEY routing secret above. Leave empty to fall back to OSM (dev).
VITE_TOMTOM_TILE_KEY=
