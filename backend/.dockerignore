# Keep the build context small and reproducible.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local DB and generated ML artifacts — runtime volumes own these.
datafuel.db
data/datafuel.db
data/datos.csv
artifacts/*.pkl

# Tests are not shipped in the production image.
tests/

# IDE / editor metadata.
.idea/
.vscode/

# Skill / agent metadata.
.agents/
.claude/

# Markdown isn't needed at runtime.
*.md
