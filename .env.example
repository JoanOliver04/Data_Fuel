# ─── Backend ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./datafuel.db

# ─── Logging ──────────────────────────────────────────────
# DEBUG (verbose) | INFO | WARNING | ERROR | CRITICAL.
# DEBUG=true overrides this and forces DEBUG.
LOG_LEVEL=INFO

# ─── MITECO API (no key required) ─────────────────────────
# Base URL — append /EstacionesTerrestres/, /FiltroProvincia/{id}, etc.
MITECO_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes

# ─── Cost per km (default: 0.13 €/km) ────────────────────
DEFAULT_KM_COST=0.13

# ─── Distance calculation ────────────────────────────────
# EUCLIDEAN (haversine) or DRIVING (real road distance via OpenRouteService).
DISTANCE_MODE=EUCLIDEAN
# Required when DISTANCE_MODE=DRIVING. Get a free key at openrouteservice.org.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_REQUEST_TIMEOUT=10.0
ORS_MATRIX_CHUNK_SIZE=50

# ─── Rate limiting ────────────────────────────────────────
GEOCODING_RATE_LIMIT=10/minute
PREDICTIONS_RATE_LIMIT=30/minute

# ─── CORS (comma-separated list of allowed origins) ───────
ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
